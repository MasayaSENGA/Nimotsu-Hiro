{
  "manifest_version": 3,
  "name": "にもつひろ",
  "version": "2.0.1",
  "description": "伝票番号を Google で検索するだけで、ヤマト運輸・佐川急便・日本郵便の追跡リンクを、にもつひろが検索結果の先頭にお届けします。",
  "author": "Masaya Senga",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/search*",
        "https://www.google.co.jp/search*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
