{
  "manifest_version": 3,
  "name": "にもつひろ",
  "version": "1.2",
  "description": "伝票番号をGoogle検索すると、にもつひろが荷物の追跡リンクをすぐにお届けします。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"},
  "content_scripts": [
    {
      "matches": ["https://www.google.com/search?*"],
      "js": ["content.js"]
    }
  ]
}